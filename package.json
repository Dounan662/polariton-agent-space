{
  "name": "polariton",
  "version": "5.0.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "qualify": "node --env-file-if-exists=.env scripts/qualify.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.harness.json",
    "build": "npm run typecheck && node scripts/check-boundaries.mjs && node scripts/build-native.mjs && vite build --config vite.config.ts",
    "start": "node src/system.ts start",
    "test": "node scripts/test.mjs",
    "stop": "node src/system.ts stop",
    "start:main": "node src/main.ts",
    "start:environment": "node src/environment/daemon.ts",
    "test:rack": "POLARITON_RACK_TESTS=1 node --test --test-concurrency=1 tests/adr009-rack.test.ts tests/adr009-launcher.test.ts",
    "verify:environment": "node --env-file-if-exists=.env scripts/verify-environment-live.mjs --live",
    "harnessctl": "node bin/harnessctl",
    "verify:release": "node scripts/check-boundaries.mjs",
    "check:public": "node scripts/check-public.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "POLARITON_PROFILE=development node src/system.ts start",
    "dev:stop": "POLARITON_PROFILE=development node src/system.ts stop",
    "verify:storage": "node scripts/verify-storage.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
