    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "micromark-util-types": "2.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
